{
  "name": "axis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "AXIS control plane for mihomo-based SOCKS5 relay gateway",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:ui",
    "build:server": "go build -o ./bin/axis ./cmd/axis",
    "build:ui": "pnpm run openapi:generate && pnpm --filter @axis/frontend build",
    "dev": "node scripts/dev.mjs",
    "dev:managed": "node scripts/dev.mjs --managed",
    "dev:server": "go run ./cmd/axis serve",
    "dev:ui": "pnpm --filter @axis/frontend dev",
    "hash-password": "go run ./cmd/axis hash-password",
    "lint": "pnpm --filter @axis/frontend lint",
    "openapi": "go run ./cmd/axis openapi",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "preflight": "go run ./cmd/axis preflight",
    "preview:ui": "pnpm --filter @axis/frontend preview",
    "start": "go run ./cmd/axis serve",
    "test": "go test ./..."
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
