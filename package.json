{
  "name": "axis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "AXIS control plane for mihomo-based SOCKS5 relay gateway",
  "scripts": {
    "build": "pnpm run build:web",
    "build:all": "pnpm run build:web && pnpm run build:desktop",
    "build:desktop": "node scripts/desktop-build.mjs",
    "build:server": "go build -tags embedui -o ./bin/axis ./cmd/axis",
    "build:ui": "pnpm run openapi:generate && pnpm --filter @axis/frontend build",
    "build:web": "pnpm run build:ui && pnpm run build:server",
    "dev": "pnpm run dev:web",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "dev:desktop:render-only": "node scripts/desktop-dev.mjs --render-only",
    "dev:server": "go run ./cmd/axis serve",
    "dev:ui": "pnpm --filter @axis/frontend dev",
    "dev:web": "node scripts/dev.mjs",
    "dev:web:render-only": "node scripts/dev.mjs --render-only",
    "hash-password": "go run ./cmd/axis hash-password",
    "lint": "pnpm --filter @axis/frontend lint",
    "openapi": "go run ./cmd/axis openapi",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "preflight": "go run ./cmd/axis preflight",
    "preview:ui": "pnpm --filter @axis/frontend preview",
    "reset:setup": "node scripts/reset-setup.mjs",
    "start": "go run ./cmd/axis serve",
    "test": "go test ./..."
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
