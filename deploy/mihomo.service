[Unit]
Description=Mihomo Data Plane For ProxyRelay
After=network-online.target proxyrelayd.service
Wants=network-online.target

[Service]
Type=simple
User=proxyrelay
Group=proxyrelay
WorkingDirectory=/var/lib/proxyrelay
ExecStart=/usr/local/bin/mihomo -d /var/lib/proxyrelay/runtime -f /var/lib/proxyrelay/runtime/mihomo.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/proxyrelay

[Install]
WantedBy=multi-user.target
