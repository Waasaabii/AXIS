[Unit]
Description=AXIS Go Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxyrelay
Group=proxyrelay
WorkingDirectory=/opt/proxyrelay
Environment=PROXYRELAY_CONFIG=/etc/proxyrelay/proxyrelay.yaml
Environment=AXIS_PUBLIC_DIR=/opt/proxyrelay/frontend/dist
ExecStart=/opt/proxyrelay/bin/axis serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/proxyrelay /var/lib/proxyrelay /opt/proxyrelay/runtime

[Install]
WantedBy=multi-user.target
